# ---- Telegram -------------------------------------------------------------
# From @BotFather
BOT_TOKEN=
BOT_USERNAME=garminofficialuzbot
# Chat that receives lead alerts (a manager's user id, or a group id)
MANAGER_CHAT_ID=
# Any random string; Telegram echoes it back so we can reject forged webhooks
WEBHOOK_SECRET=

# ---- AI (via OpenRouter) ---------------------------------------------------
# https://openrouter.ai/settings/keys
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model id works here — see https://openrouter.ai/models
AI_MODEL=google/gemini-3.8-flash
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=900

# ---- Server ---------------------------------------------------------------
PORT=3000
# webhook | polling. Leave unset: defaults to webhook on Render, polling locally
BOT_MODE=polling
# Public https URL of this service. Render injects RENDER_EXTERNAL_URL for you
PUBLIC_URL=
# Self-ping to keep the free Render instance from spinning down
KEEP_ALIVE=true
KEEP_ALIVE_MINUTES=12

# ---- Business links -------------------------------------------------------
WEBAPP_URL=https://garmin-webapp.onrender.com
SITE_URL=https://www.garmin.com.uz
CATALOG_URL=https://www.garmin.com.uz/catalog
# Public call center number — fine to put in buttons/links.
CONTACT_PHONE=+998701203333
# Manager's direct line — only ever spoken as text on explicit /manager, never
# in a button. Leave blank to fall back to CONTACT_PHONE.
MANAGER_PHONE=
# Human-run Telegram channel, separate from this bot.
HUMAN_TELEGRAM_URL=https://t.me/Garmin_callcenter

LEADS_FILE=./data/leads.jsonl

# ---- Extended catalog (non-watch products) --------------------------------
# Public channel where product photos + Cyrillic descriptions get posted.
# The bot must be added as an ADMIN of this channel — that's the only way
# Telegram delivers channel posts to it at all.
CHANNEL_CATALOG_ID=@cataloggarmintest
CHANNEL_CATALOG_FILE=./data/channel-catalog.jsonl
